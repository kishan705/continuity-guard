     "ts": "00:23",
     "ts_sec": 23.0,
     "ts_inferred": false,
     "kind": "action",
     "speaker": null,
     "text": "Cole presses his tear-stained face against Harper's lifeless hand, his fake mechanic identity shattered forever now that she knows the truth."
